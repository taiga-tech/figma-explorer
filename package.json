{
  "name": "figma-explorer",
  "displayName": "Figma Explorer",
  "version": "0.0.1",
  "description": "Chrome extension for organizing Figma Drafts files",
  "author": "taiga-tech",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^29.1.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.9"
  },
  "manifest": {
    "permissions": [
      "scripting"
    ],
    "host_permissions": [
      "https://*/*"
    ]
  }
}
